# SQLite 파일 위치 (기본: ./data/now.db)
# NOW_DB_PATH=./data/now.db


# ── AI 공급자 키 (DB 에는 이 "이름" 만 저장된다) ─────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ── 워커 · 런타임 ───────────────────────────────────
# NOW_WORKER=off                 # 서버 안 워커 끄기 (npm run worker 로 따로 실행할 때)
# NOW_WORKER_INTERVAL_MS=5000
# NOW_ALLOW_COMMAND_PROVIDER=1   # 로컬 CLI 에이전트(셸 명령) 허용 — 신뢰하는 명령만
# NOW_COMMAND_TIMEOUT_SEC=900
# NOW_PUBLIC_URL=http://127.0.0.1:3000   # 로컬 CLI 에이전트가 접속할 주소
# NOW_OPERATOR_NAME=운영자

# ── 웹훅 비밀 (트리거에 env:이름 / 서명 환경변수 이름으로 지정) ──
# SLACK_WEBHOOK_URL=
# SLACK_WEBHOOK_SECRET=
